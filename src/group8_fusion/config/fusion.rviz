Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: velodyne
    Background Color: 14; 20; 30
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Ground grid
    Enabled: true
    Cell Size: 2
    Plane Cell Count: 40
    Color: 50; 65; 85
    Alpha: 0.4
  - Class: rviz_default_plugins/PointCloud2
    Name: LiDAR raw
    Enabled: true
    Topic:
      Value: /velodyne/points_raw
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Style: Points
    Size (Pixels): 2
    Color Transformer: FlatColor
    Color: 75; 155; 210
    Position Transformer: XYZ
    Decay Time: 0.0
    Alpha: 0.75
    Use Fixed Frame: true
  - Class: rviz_default_plugins/PointCloud2
    Name: LiDAR objects
    Enabled: true
    Topic:
      Value: /fusion/nonground
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Style: Points
    Size (Pixels): 3
    Color Transformer: FlatColor
    Color: 105; 225; 205
    Position Transformer: XYZ
    Decay Time: 0.0
    Alpha: 0.75
    Use Fixed Frame: true
  - Class: rviz_default_plugins/PointCloud2
    Name: Radar returns
    Enabled: true
    Topic:
      Value: /PointCloudDetection
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Style: Points
    Size (Pixels): 7
    Color Transformer: FlatColor
    Color: 255; 110; 70
    Position Transformer: XYZ
    Decay Time: 0.0
    Alpha: 0.75
    Use Fixed Frame: true
  - Class: rviz_default_plugins/TF
    Name: Sensor frames
    Enabled: true
    Show Axes: true
    Show Names: true
    Marker Scale: 1.5
    Frame Timeout: 15
    Frames:
      All Enabled: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Fused tracks
    Enabled: true
    Marker Topic:
      Value: /fusion/markers
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Image
    Name: Camera fusion
    Enabled: true
    Topic:
      Value: /fusion/image
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Normalize Range: true
    Min Value: 0
    Max Value: 1
    Median window: 5
  Enabled: true
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Road view
      Distance: 48
      Yaw: 3.14
      Pitch: 0.9
      Focal Point:
        X: 15
        Y: 0
        Z: 0
      Target Frame: velodyne
      Near Clip Distance: 0.01
    Saved: []
Window Geometry:
  Width: 1600
  Height: 1000
  X: 60
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: false
  Camera fusion:
    collapsed: false
