Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: velodyne
    Background Color: 13; 19; 28
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Ground grid
    Enabled: true
    Cell Size: 2
    Plane Cell Count: 40
    Color: 50; 65; 85
    Alpha: 0.18
  - Class: rviz_default_plugins/PointCloud2
    Name: Raw returns (grey)
    Enabled: true
    Topic:
      Value: /review/raw_points
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Style: Points
    Size (Pixels): 1
    Color Transformer: FlatColor
    Color: 100; 120; 140
    Position Transformer: XYZ
    Decay Time: 0.0
    Alpha: 0.15
    Use Fixed Frame: true
  - Class: rviz_default_plugins/PointCloud2
    Name: Prepared LiDAR input
    Enabled: true
    Topic:
      Value: /review/processed_points
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Style: Points
    Size (Pixels): 2
    Color Transformer: FlatColor
    Color: 100; 225; 205
    Position Transformer: XYZ
    Decay Time: 0.0
    Alpha: 0.8
    Use Fixed Frame: true
  - Class: rviz_default_plugins/MarkerArray
    Name: LiDAR proposals
    Enabled: true
    Topic:
      Value: /review/boxes
      Depth: 5
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
  - Class: rviz_default_plugins/Image
    Name: Processing trace
    Enabled: true
    Topic:
      Value: /review/image
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Normalize Range: true
    Min Value: 0
    Max Value: 1
    Median window: 5
  Enabled: true
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Lidar diagnostic view
      Distance: 30
      Yaw: 3.14
      Pitch: 0.7
      Focal Point:
        X: 15
        Y: 0
        Z: -1
      Target Frame: velodyne
      Near Clip Distance: 0.01
    Saved:
    - Class: rviz_default_plugins/TopDownOrtho
      Name: Bird's-eye view
      Target Frame: velodyne
      Scale: 22
      Angle: -1.5707963267948966
      X: 20
      Y: 0
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1600
  Height: 1000
  X: 80
  Y: 60
  Hide Left Dock: false
  Hide Right Dock: false
  Camera fusion:
    collapsed: false
